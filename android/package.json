{
  "name": "dealcraft-android",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "setup": "npx cap add android",
    "sync": "npx cap sync android",
    "open": "npx cap open android",
    "icons": "npx @capacitor/assets generate --android --iconBackgroundColor \"#FBF8F1\" --splashBackgroundColor \"#FBF8F1\"",
    "apk": "npx cap sync android && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/app": "^6.0.1",
    "@capacitor/core": "^6.1.2",
    "@capacitor/haptics": "^6.0.1",
    "@capacitor/status-bar": "^6.0.1",
    "@capacitor/filesystem": "^6.0.1",
    "@capacitor/share": "^6.0.2"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.1.2"
  }
}
